<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="530.0" prefWidth="403.0" style="-fx-background-color: #191970;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am31.view.gui.SelectedTileController">
   <children>
      <ImageView fx:id="componentImageView" fitHeight="151.0" fitWidth="152.0" layoutX="185.0" layoutY="59.0" pickOnBounds="true" preserveRatio="true" />
      <Button fx:id="rotateButton" layoutX="54.0" layoutY="102.0" mnemonicParsing="false" onAction="#rotateImage" text="Rotate" />
      <Label alignment="CENTER" layoutX="79.0" layoutY="248.0" prefHeight="17.0" prefWidth="90.0" text="Select position x" textFill="WHITE" />
      <Label alignment="CENTER" layoutX="238.0" layoutY="248.0" prefHeight="17.0" prefWidth="90.0" text="Select position y" textFill="#fffefe" />
      <TextField layoutX="111.0" layoutY="280.0" prefHeight="25.0" prefWidth="27.0" fx:id="xField" />
      <TextField fx:id="yField" layoutX="270.0" layoutY="280.0" prefHeight="25.0" prefWidth="27.0" />
      <Button fx:id="okButton" layoutX="185.0" layoutY="325.0" mnemonicParsing="false" onAction="#confirmComponent" text="OK" />
      <Button fx:id="removeButton" disable="true" layoutX="54.0" layoutY="156.0" mnemonicParsing="false" onAction="#removeComponent" text="Remove" />
      <Label fx:id="reserveMessage" alignment="CENTER" layoutX="86.0" layoutY="414.0" prefHeight="17.0" prefWidth="231.0" textFill="WHITE" />
   </children>
</AnchorPane>
