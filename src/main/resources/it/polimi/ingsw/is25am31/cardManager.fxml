<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="809.0" prefWidth="615.0" style="-fx-background-color: #191970;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am31.view.gui.CardManagerController">
    <children>
        <ImageView fx:id="cardImageView" fitHeight="334" fitWidth="228" layoutX="38.0" layoutY="155.0" />
        <Label fx:id="descriptionLabel" layoutX="297.0" layoutY="14.0" prefHeight="608.0" prefWidth="281.0" textFill="WHITE" wrapText="true" />
        <TextField fx:id="commandInputField" layoutX="117.0" layoutY="628.0" prefWidth="360" promptText="Enter command..." />
        <Button fx:id="sendButton" layoutX="271.0" layoutY="702.0" onAction="#onSendCommand" text="Send">
         <font>
            <Font name="Agency FB" size="18.0" />
         </font></Button>
        <Label fx:id="errorLabel" layoutX="117.0" layoutY="667.0" prefWidth="360" textFill="red" wrapText="true" />
      <Label fx:id="diceLabel" layoutX="30.0" layoutY="710.0" prefHeight="17.0" prefWidth="228.0" textFill="#2cff00" wrapText="true" />
      <Label fx:id="infoLabel" layoutX="117.0" layoutY="758.0" prefWidth="360" textFill="WHITE" wrapText="true" />
    </children>
</AnchorPane>
