<AnchorPane prefHeight="768.0" prefWidth="615.0" style="-fx-background-color: #191970;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am31.view.gui.FinalStageController">

    <VBox alignment="CENTER" layoutX="25.0" layoutY="25.0" spacing="15" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="🏁 Final Score" textFill="WHITE" />

        <TextArea fx:id="rankingTextArea" editable="false" prefHeight="300" prefWidth="450" style="-fx-font-size: 14px;" wrapText="true" />

        <Button onAction="#handleClose" text="Close" />
    </VBox>
</AnchorPane>
