<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="328.0" prefWidth="602.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.is25am31.view.gui.WaitingRoomController">
    <Label alignment="CENTER" layoutX="205.0" layoutY="38.0" prefHeight="39.0" prefWidth="195.0" text="⏳ Waiting for the other players..." />
   <Button fx:id="timerButton" layoutX="276.0" layoutY="106.0" mnemonicParsing="false" text="TIMER" />
   <Button fx:id="setPositionButton" layoutX="251.0" layoutY="245.0" mnemonicParsing="false" onAction="#handleSetPosition" text="SET POSITION">
      <font>
         <Font name="Agency FB" size="18.0" />
      </font>
   </Button>
   <TextField fx:id="positionField" layoutX="285.0" layoutY="197.0" prefHeight="27.0" prefWidth="33.0" />
   <Label fx:id="availablePositionsLabel" alignment="CENTER" layoutX="249.0" layoutY="164.0" text="Available Position :" />
   <Label fx:id="errorLabel" layoutX="287.0" layoutY="296.0" text="" />
</AnchorPane>
